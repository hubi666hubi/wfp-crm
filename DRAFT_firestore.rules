rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
  
    match /{document=**} {
      allow read, write: if false;
    }
    
    function isSignedIn() { return request.auth != null; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    
    function isValidUserConfig(data) {
       return data.keys().hasAny(['displayName', 'photoURL', 'email', 'createdAt']) &&
         (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100)) &&
         (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500)) &&
         (!('email' in data) || (data.email is string && data.email.size() <= 200)) &&
         (!('createdAt' in data) || (data.createdAt is string));
    }
    
    match /users/{userId} {
      allow read: if isSignedIn() && isValidId(userId);
      allow create: if isSignedIn() && request.auth.uid == userId && isValidId(userId) && isValidUserConfig(incoming());
      allow update: if isSignedIn() && request.auth.uid == userId && isValidId(userId) && isValidUserConfig(incoming());
    }

    function isValidDashboardConfig(data) {
       return data.keys().hasAny(['tasks', 'stats']) &&
         (!('tasks' in data) || (data.tasks is list && data.tasks.size() <= 100)) &&
         (!('stats' in data) || (data.stats is list && data.stats.size() <= 100));
    }

    match /dashboards/{userId} {
      allow read: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
      allow create, update: if isSignedIn() && request.auth.uid == userId && isValidId(userId) && isValidDashboardConfig(incoming());
    }
    
    match /test/connection {
       allow read: if isSignedIn();
       allow write: if false;
    }
  }
}
